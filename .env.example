# The database the app reads and the pipeline writes. Hosted on Neon.
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Clone of the above that the test suites wipe and rebuild. Must be named *_test
# or the suites refuse to start. Rebuild it with: node scripts/refreshTestDb.mjs
TEST_DATABASE_URL=postgresql://user:password@host.neon.tech/powerranking_test?sslmode=require

# Source database for refreshTestDb.mjs. Normally the same as DATABASE_URL.
NEON_DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

LIQUIPEDIA_API_KEY=
